							</deities>
						</foundation>
						<name>米莉拉帝国正教</name>
						<adjective>-坦陀罗</adjective>
						<memberName>-坦陀罗教徒</memberName>
						<leaderTitleMale>大主教</leaderTitleMale>
						<leaderTitleFemale>大主教</leaderTitleFemale>
						<description>毁灭之神&lt;color=#D09B61FF&gt;陪胪&lt;/color&gt;，在鲁图尼的众人跟前展现了他的真身，只为了指导他们，让他们理解自由。 娱乐大亨强迫-坦陀罗教徒穿上制服，在娱乐大亨扩容诊所工作。 &lt;color=#D09B61FF&gt;陪胪&lt;/color&gt;决定化身为一名叫David 'Dragon' Burninghouse的人来到鲁图尼，以便帮助这里的-坦陀罗教徒。 Dragon于一个超级游艇中聚集了一群-坦陀罗教徒，向他们宣扬了&lt;color=#D09B61FF&gt;陪胪&lt;/color&gt;的智慧。</description>
						<descriptionTemplate>%%Deity0_type%%%%deity0_name%%，在鲁图尼的众人跟前展现了%%deity0_objective%%的真身，只为了指导他们，让他们理解自由。 娱乐大亨强迫%%memberNamePlural%%穿上制服，在娱乐大亨扩容诊所工作。 %%Deity0_name%%决定化身为一名叫David 'Dragon' Burninghouse的人来到鲁图尼，以便帮助这里的%%memberNamePlural%%。 Dragon于一个超级游艇中聚集了一群%%memberNamePlural%%，向他们宣扬了%%deity0_name%%的智慧。</descriptionTemplate>
						<classic>True</classic>
						<culture>MiliraImperiumCulture</culture>
						<iconDef>MI_IdeoIcon</iconDef>
						<colorDef>DarkSapphire</colorDef>
						<memes>
							<li>Structure_OriginHindu</li>
							<li>Individualist</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>和谐葬礼</name>
								<def>Funeral</def>
								<ID>4309</ID>
								<randomSeed>-1993996697</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>你可以为{PAWN_nameDef}举行一场{IDEOLIGION_adjective}葬礼</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>你可以为{PAWN_nameDef}举行一场葬礼。</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_4309</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
