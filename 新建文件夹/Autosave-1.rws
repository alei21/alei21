					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Wavia</place>
							<deities>
								<li>
									<name>梵天</name>
									<type>创世之神</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Bloodfeeding</relatedMeme>
								</li>
								<li>
									<name>密特拉</name>
									<type>友谊之神</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_OriginHindu</relatedMeme>
								</li>
								<li>
