					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Lutuni</place>
							<deities>
								<li>
									<name>陪胪</name>
									<type>毁灭之神</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Individualist</relatedMeme>
								</li>
								<li>
									<name>加雅缇</name>
									<type>生命之神</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_OriginHindu</relatedMeme>
								</li>
								<li>
									<name>索玛</name>
									<type>月神</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Individualist</relatedMeme>
								</li>
								<li>
									<name>尼多拉</name>
									<type>睡眠之神</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_OriginHindu</relatedMeme>
