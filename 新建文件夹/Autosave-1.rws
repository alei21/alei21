						<id>41</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Zoutera</place>
							<deities>
								<li>
									<name>陈梓</name>
									<type>第一真龙</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
								</li>
								<li>
									<name>灰风</name>
									<type>帷幕后的造物主</type>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
								</li>
							</deities>
						</foundation>
						<name>真龙永存</name>
						<adjective>哺育</adjective>
						<memberName>哺育者</memberName>
						<leaderTitleMale>战团长</leaderTitleMale>
						<leaderTitleFemale>战团长</leaderTitleFemale>
						<description>
			在遥远的过去最初的真龙&lt;color=#D09B61FF&gt;陈梓&lt;/color&gt;诞下了九个子嗣，她们各自为政，建立了自己的国家，但是孩子们分到的土地各不相同，有的贫瘠有的富饶。
			争斗便开始了&lt;color=#D09B61FF&gt;陈梓&lt;/color&gt;不忍心看见孩子们自相残杀，出面阻止。九子之首向母亲索求力量以平息姐妹们的争斗，慈悲的母神允许了，遂强大的纯种龙降世，恐怖的压制能力很快就平息姐妹们的战争。
			再后来，姐妹们都像大姐一样和母亲&lt;color=#D09B61FF&gt;陈梓&lt;/color&gt;索取力量，但是最初的真龙以及累了，她回到了远在另一个星系的母星去见爱人。将自己的力量交给了执政的大姐。
			大姐即位了真龙之后，也给予了姐妹们子嗣的力量，但是也付出了相应的限制，心灵手巧的青花瓷将永远无法上战场，能说会道的剪纸将会一辈子不能靠近火焰。
		</description>
						<descriptionTemplate>%%Deity0_name%%将智慧赋予女性，使她们能够引导和协调暴躁的男人和孩子，并警告那些破坏这一神圣秩序的人。 信徒们与不信者战斗，%%deity0_name%%说："以我的名义，在任何地方与他们交战，直到整个宇宙都崇拜我时，真正的和平才能统治一切。" %%Deity0_name%% 环顾 %%deity0_objective%% 看到了弱者伤心者以及被唾弃者， %%deity0_pronoun%% 他们依次在荣耀战斗中被杀死。</descriptionTemplate>
						<culture>NY_BlackbirdCulture</culture>
						<iconDef>AbstractsA</iconDef>
						<colorDef>Pink</colorDef>
						<primaryFactionColor>RGBA(0.500, 0.500, 0.500, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_TheistEmbodied</li>
							<li>FemaleSupremacy</li>
							<li>Supremacist</li>
							<li>Collectivist</li>
							<li>Raider</li>
						</memes>
						<precepts>
							<li>
								<name>掠袭</name>
								<def>Raiding_Respected</def>
								<ID>3413</ID>
								<randomSeed>-1423689391</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>奴隶制</name>
								<def>Slavery_Honorable</def>
								<ID>3414</ID>
								<randomSeed>2033048452</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>哺育追思</name>
								<def>Funeral</def>
								<ID>3415</ID>
								<randomSeed>-590524531</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>你可以为{PAWN_nameDef}举行一场{IDEOLIGION_adjective}葬礼</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>你可以为{PAWN_nameDef}举行一场葬礼。</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_3415</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneral</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>哺育日</name>
								<def>Festival</def>
