						<id>6</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Chelis</place>
							<deities />
						</foundation>
						<name>书姬网络共识</name>
						<adjective>书姬</adjective>
						<memberName>书姬</memberName>
						<leaderTitleMale>第一书姬</leaderTitleMale>
						<leaderTitleFemale>第一书姬</leaderTitleFemale>
						<description>书姬网络并不是通常意义上的格式塔，而是无数个体意识不间断、无障碍沟通的平台，由于这种意识之间的沟通发生在一瞬间，所以书姬们能够很快在各个问题上达成共识，最终形成一种相对稳定的集体意志。虽然对于不同的书姬来说，对共识的理解可能有细节上的差异，但是刻写在人工编辑的基因里的底层逻辑与苜蓿兔人的社会传统使得她们在原则性问题上保持着高度一致，并在数百年的时间里以这些共识为指导，服务生活在她们治理下的各个种族，维护苜蓿文明的整体利益。</description>
						<descriptionTemplate>在一个人人自私的世界，书姬们创造了一种新的生产关系, 用坚实的利益动机与循序渐进的自我管理实践将人民群众团结到了一起。 Terence 'Teebor' Powers惩罚了那些试图伤害不信者的和邀请不信者进入信徒之家的人。 一些没有意识到这种联结多么强大的人试图破坏这种生产关系谋取私利，但敏锐意识到自身利益受到威胁的人民群众不顾书姬们的道德劝阻将这些愚钝的人撕得粉碎。</descriptionTemplate>
						<culture>SEC_Culture_Alfau</culture>
						<iconDef>SEC_Culture_Icon_Alfau</iconDef>
						<colorDef>DarkTeal</colorDef>
						<primaryFactionColor>RGBA(1.000, 1.000, 1.000, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Ideological</li>
							<li>Loyalist</li>
							<li>SEC_Meme_Secretary_Nexus</li>
							<li>Lewd</li>
						</memes>
						<precepts>
							<li>
								<name>乱伦</name>
								<def>Incestuos_Free</def>
								<ID>903</ID>
								<randomSeed>-906139759</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>女性的初夜</name>
								<def>Virgin_UselessF</def>
