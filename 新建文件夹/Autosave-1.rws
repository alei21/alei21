					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Chelis</place>
							<deities>
								<li>
									<name>基督</name>
									<type>世界之神</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>PathOfLantern</relatedMeme>
