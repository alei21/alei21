								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>生日</name>
								<def>OARK_Birthday_Fear</def>
								<ID>905</ID>
								<randomSeed>26871588</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>社区氛围</name>
								<def>OA_RK_Community_Turbulent</def>
								<ID>906</ID>
